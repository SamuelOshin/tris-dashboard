# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://tris_user:tris_password@localhost:5433/tris_db

# Security & JWT Configuration
SECRET_KEY=tris_dev_secret_key_change_in_production_min_32_bytes_long_safe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment Settings
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# One-click sign-in as the demo roles on the login page. Needs no password, so enable it only on a
# demonstration deployment that holds synthetic data.
DEMO_LOGIN_ENABLED=false

# Run "alembic upgrade head" at start-up, one instance at a time. Leave false in production unless
# you have no release step to run it (see app/api/db/auto_migrate.py).
AUTO_MIGRATE=false
